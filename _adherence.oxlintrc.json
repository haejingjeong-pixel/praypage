{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "components/prescription/**",
              "doc-page.js",
              "mind-pharmacy/**",
              "mind-pharmacy/data/**",
              "ui_kits/soul-pharmacy/**",
              "ui_kits/soul-pharmacy/animation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif KR|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif KR, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssessmentGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|question|options|key|ref|className|style|children)$/]",
        "message": "<AssessmentGroup> doesn't accept that prop. Declared props: number, question, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|icon|block|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: tone, size, icon, block, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|rx|outline|ghost)$/]",
        "message": "<Button> tone must be one of 'coral' | 'rx' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|spacing|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: color, spacing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntakeSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|width|children|style|key|ref|className|style|children)$/]",
        "message": "<IntakeSheet> doesn't accept that prop. Declared props: title, subtitle, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoodDef'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|fill|ink|word|key|ref|className|style|children)$/]",
        "message": "<MoodDef> doesn't accept that prop. Declared props: label, icon, fill, ink, word."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrescriptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|title|footer|width|children|style|key|ref|className|style|children)$/]",
        "message": "<PrescriptionCard> doesn't accept that prop. Declared props: brand, title, footer, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrescriptionWord'] > JSXAttribute > JSXIdentifier[name!=/^(?:word|label|style|key|ref|className|style|children)$/]",
        "message": "<PrescriptionWord> doesn't accept that prop. Declared props: word, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RxField'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|verse|reference|inline|style|key|ref|className|style|children)$/]",
        "message": "<RxField> doesn't accept that prop. Declared props: icon, label, value, verse, reference, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|current|tone|style|key|ref|className|style|children)$/]",
        "message": "<StepIndicator> doesn't accept that prop. Declared props: total, current, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndicator'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rx|coral)$/]",
        "message": "<StepIndicator> tone must be one of 'rx' | 'coral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WoodShelf'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|style|key|ref|className|style|children)$/]",
        "message": "<WoodShelf> doesn't accept that prop. Declared props: width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tagline|mark|color|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, tagline, mark, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:cross|heart|none)$/]",
        "message": "<Wordmark> mark must be one of 'cross' | 'heart' | 'none'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
